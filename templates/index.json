    "customer_reviews_tabs_CqTfmC": {
      "type": "customer-reviews-tabs",
      "blocks": {
        "customer_reviews_tab_nUmhez": {
          "type": "_customer-reviews-tab",
          "settings": {
            "tab_label": "LEISTUNGS-GUMMIES"
