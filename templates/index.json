                "customer_review_tag_H8Vdzd"
              ]
            },
            "customer_review_card_mgQyPx": {
              "type": "_customer-review-card",
              "settings": {
                "customer_name": "Andreas W.",
                "rating": 5,
                "show_verified_badge": true,
                "verified_badge_text": "Verifizierter Kunde",
                "label_text": "LUST UND VITALITÄT",
                "review_text": "<p>Ich nehme es jetzt seit etwa zwei Monaten, und man merkt den Unterschied. Mehr Energie, bessere Durchblutung und ein Gefühl von Vitalität, das ich schon lange nicht mehr gespürt hatte. Mir ist wichtig, dass die Inhaltsstoffe klar aufgelistet und klinisch untersucht sind, und nicht irgendeine geheimnisvolle Mischung, die nur als Marke eingetragen ist. Die Kombination aus L-Arginin und Maca hält wirklich, was sie verspricht.</p>"
              },
