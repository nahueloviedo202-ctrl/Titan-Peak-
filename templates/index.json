              ]
            },
            "customer_review_card_XikKRR": {
              "type": "_customer-review-card",
              "settings": {
                "customer_name": "Stefan K.",
                "rating": 5,
                "show_verified_badge": true,
                "verified_badge_text": "Verifizierter Kunde",
                "label_text": "AUSDAUER-BOOSTER",
                "review_text": "<p>Meine Ausdauer beim Training hat sich wirklich verbessert, seit ich damit angefangen habe. Ich breche schon persönliche Rekorde, die ich für unmöglich hielt, und ich erhole mich auch schneller. Da es keine Stimulanzien enthält, kann ich es zu jeder Tageszeit nehmen, ohne Herzrasen oder Schlafprobleme. Einfach eine konstante, verlässliche Unterstützung, die sich mit der Zeit aufbaut.</p>"
              },
              "blocks": {
                "customer_review_tag_qJEbfY": {
                  "type": "_customer-review-tag",
                  "settings": {
                    "text": "Leistung beim Training"
                  },
